    %delay 5000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v00000161dd0d43a0_0, 0, 4;
    %delay 5000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v00000161dd0d43a0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call 2 19 "$finish" {0 0 0};
