
module stimulus; 
parameter BUS_WIDTH = 4;
reg clk;
reg rst_n;
wire [BUS_WIDTH-1:0]o_LED;

parameter CLK_1s = 1*10**9;  // 1sec = 10**9ns
parameter CLK_HALF_PERIOD_ns = 10;   // 20ns/2 = 50MHz
  parameter LED_FREQ = 4;

 blinky_led #(.CLOCK_FREQ(CLK_1s/2*CLK_HALF_PERIOD_ns),  // 
  .LED_FREQ(LED_FREQ),
  .BUS_WIDTH(BUS_WIDTH))
    uut(.clk(clk),.rst_n(rst_n),.o_LED(o_LED));

// create the clock signal 
  always begin
  #(CLK_HALF_PERIOD_ns);   clk = ~clk;  // 50 MHz clock 
  end

  // test scennario
  initial begin
    $dumpfile("blinky_led.vcd");
    $dumpvars(0, stimulus);
    rst_n = 0;
    repeat(5) @(posedge clk);  // keep the design reset for a few clocks
    rst_n = 1;
    repeat(LED_FREQ+1) @(posedge o_LED);
    #100 $finish;
    
  end
endmodule 

// iverilog -o blinky_led_tb.out blinky_led.v blinky_led_tb.v
// vvp blinky_led_tb.out

// gtkwave blinky_led.vcd