#! /mingw64/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "C:\msys64\mingw64\lib\ivl\system.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\v2005_math.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\va_math.vpi";
S_000002e0b6dedde0 .scope module, "stimulus" "stimulus" 2 2;
 .timescale -6 -9;
P_000002e0b6de9680 .param/l "ADDER_WIDTH" 0 2 3, +C4<00000000000000000000000000001010>;
v000002e0b6dee010_0 .var "a", 9 0;
v000002e0b6e40d50_0 .var "b", 9 0;
v000002e0b6e40df0_0 .net "sum", 10 0, v000002e0b6dedf70_0;  1 drivers
S_000002e0b6de7100 .scope module, "uut" "nbit_adder" 2 8, 3 1 0, S_000002e0b6dedde0;
 .timescale 0 0;
    .port_info 0 /INPUT 10 "a";
    .port_info 1 /INPUT 10 "b";
    .port_info 2 /OUTPUT 11 "sum";
P_000002e0b6de9780 .param/l "N" 0 3 1, +C4<00000000000000000000000000001010>;
v000002e0b6dedab0_0 .net "a", 9 0, v000002e0b6dee010_0;  1 drivers
v000002e0b6dedb50_0 .net "b", 9 0, v000002e0b6e40d50_0;  1 drivers
v000002e0b6dedf70_0 .var "sum", 10 0;
E_000002e0b6de9300 .event anyedge, v000002e0b6dedab0_0, v000002e0b6dedb50_0;
    .scope S_000002e0b6de7100;
T_0 ;
    %wait E_000002e0b6de9300;
    %load/vec4 v000002e0b6dedab0_0;
    %pad/u 11;
    %load/vec4 v000002e0b6dedb50_0;
    %pad/u 11;
    %add;
    %store/vec4 v000002e0b6dedf70_0, 0, 11;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000002e0b6dedde0;
T_1 ;
    %vpi_call 2 11 "$dumpfile", "adder_nbit.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_000002e0b6dedde0 {0 0 0};
    %vpi_call 2 13 "$monitor", $time, "a = %d, b = %d, sum = %d", v000002e0b6dee010_0, v000002e0b6e40d50_0, v000002e0b6e40df0_0 {0 0 0};
    %delay 1000, 0;
    %pushi/vec4 0, 0, 10;
    %store/vec4 v000002e0b6dee010_0, 0, 10;
    %pushi/vec4 0, 0, 10;
    %store/vec4 v000002e0b6e40d50_0, 0, 10;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 10;
    %store/vec4 v000002e0b6dee010_0, 0, 10;
    %pushi/vec4 99, 0, 10;
    %store/vec4 v000002e0b6e40d50_0, 0, 10;
    %delay 5000, 0;
    %pushi/vec4 33, 0, 10;
    %store/vec4 v000002e0b6dee010_0, 0, 10;
    %pushi/vec4 66, 0, 10;
    %store/vec4 v000002e0b6e40d50_0, 0, 10;
    %delay 5000, 0;
    %pushi/vec4 100, 0, 10;
    %store/vec4 v000002e0b6dee010_0, 0, 10;
    %pushi/vec4 47, 0, 10;
    %store/vec4 v000002e0b6e40d50_0, 0, 10;
    %delay 10000, 0;
    %vpi_call 2 19 "$finish" {0 0 0};
    %end;
    .thread T_1;
